EntraIdSignInEvents
| where AccountUpn == "sriadmin@srientralab.onmicrosoft.com"
| where SessionId == "REDACTED_SESSION_ID"
| project
    Timestamp,
    Application,
    ApplicationId,
    IPAddress,
    UserAgent,
    ClientAppUsed,
    EndpointCall,
    ErrorCode,
    AuthenticationRequirement,
    SessionId
| order by Timestamp asc
